# Plantilla para core/.env. No contiene secretos reales.
DEBUG=False
SECRET_KEY=CAMBIAR_POR_SECRETO_PRIVADO
ENGINE=django.db.backends.mysql
DB_NAME=smart_evolution_test
DB_USER=admin
DB_PASSWORD=CONFIGURAR_EN_EL_SERVIDOR
DB_HOST=CONFIGURAR_EN_EL_SERVIDOR
DB_PORT=3306

# La politica estricta permanece activa en desarrollo y produccion.
AUTH_SECURITY_ENVIRONMENT=production
AUTH_JWT_ALGORITHM=RS256
# Compose proporciona estas rutas dentro de cada contenedor.
AUTH_JWT_SIGNING_KEY_FILE=/run/secrets/jwt-private.pem
AUTH_JWT_VERIFYING_KEY_FILE=/run/secrets/jwt-public.pem
AUTH_REDIS_URL=redis://redis:6379/3
AUTH_LOGIN_IDENTIFIER_SECRET=CAMBIAR_POR_SECRETO_INDEPENDIENTE
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Strict

# Mantener desactivado hasta integrar la clave publica en el frontend.
AUTH_CAPTCHA_ENABLED=False
AUTH_CAPTCHA_AFTER_FAILURES=3
AUTH_CAPTCHA_MISSING_RETRY_SECONDS=60
AUTH_TURNSTILE_SECRET_KEY=CONFIGURAR_SIN_COMPARTIR
# Desarrollo: devapp.smartevolution.com.co; produccion: app.smartevolution.com.co
AUTH_TURNSTILE_EXPECTED_HOSTNAMES=devapp.smartevolution.com.co
AUTH_TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify
